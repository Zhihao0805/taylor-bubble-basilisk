#!/usr/bin/env bash
# 2D Taylor bubble on Delta: default (lightweight) profile.
# Source this file in bundle scripts.

set -euo pipefail

# Common
export RE=0.1
export TOL_DEFAULT=1e-5
export EPS_U=0.007
export EPS_F=0.1

# Campaign 1: Grid convergence
export GRID_CA=0.01
export GRID_LEVS="8,9,10"
export GRID_TMAX=0.08

# Campaign 2: Poisson tolerance sensitivity
export TOL_VALUES="1e-3,1e-5,1e-7"
export TOL_LEV=9
export TOL_CA=0.01
export TOL_TMAX=0.10

# Campaign 3: Ca sweep
export CA_VALUES="0.002,0.005,0.01,0.02,0.05,0.1"
export CA_LEV=8
export CA_LEV_LOW=9
export CA_LOW_THRESHOLD=0.003
export CA_TMAX=0.08

# Centered movie case
export MOVIE_CA=0.01
export MOVIE_LEV=9
export MOVIE_TMAX=0.15

# If Delta resources are sufficient, you can try this heavier profile:
# GRID_LEVS="8,9,10,11"
# GRID_TMAX=0.12
# TOL_LEV=10
# TOL_TMAX=0.15
# CA_VALUES="0.0005,0.001,0.002,0.005,0.01,0.02,0.05,0.1"
# CA_LEV=9
# CA_LEV_LOW=10
# CA_LOW_THRESHOLD=0.001
# CA_TMAX=0.12
# MOVIE_LEV=10
# MOVIE_TMAX=0.2
